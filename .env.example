# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Groq LLM (free tier)
GROQ_API_KEY=your_groq_api_key_here

# Encryption Master Key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_MASTER_KEY=your_encryption_key_here

# Database URL
# For SQLite (dev): sqlite:///trading_agent.db
# For PostgreSQL: postgresql://user:password@localhost:5432/trading_agent
DATABASE_URL=sqlite:///trading_agent.db

# Optional: Market API Keys
KALSHI_API_KEY=optional
POLYMARKET_API_KEY=optional

# Optional: Solana RPC
SOLANA_RPC_URL=https://api.devnet.solana.com

# Optional: Logging
LOG_LEVEL=INFO
