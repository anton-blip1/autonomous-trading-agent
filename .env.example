# ANTHROPIC API
ANTHROPIC_API_KEY=sk-your-api-key-here

# TELEGRAM BOT (Optional - for UI)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_ID=123456789

# SOLANA
# Private key will be auto-generated from devnet keypair
# Or paste your devnet wallet's private key here for existing wallet
SOLANA_PRIVATE_KEY=

# KALSHI API (Optional)
KALSHI_USERNAME=your_kalshi_username
KALSHI_PASSWORD=your_kalshi_password

# POLYMARKET API (Optional - usually public)
POLYMARKET_API_KEY=

# LOGGING
LOG_LEVEL=INFO

# TRADING (Override defaults in config.py if needed)
ENABLE_LIVE_TRADING=true
INITIAL_BANKROLL_USD=1000
